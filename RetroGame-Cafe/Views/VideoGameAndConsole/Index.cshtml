@model IEnumerable<RetroGame_Cafe.Models.VideoGameViewModel>

@{
    ViewData["Title"] = "Index";

    var consoles = ViewData["consoles"] as IEnumerable<string>;
}

<h1>Nos Consoles et Jeux Vidéo</h1>

@if (User.IsInRole("Admin") || User.IsInRole("Modo"))
{
    <a asp-action="Create">Create New</a>
}

@foreach (var con in consoles!)
{
    <h3>@con</h3>
    <table class="table">
        <thead>
            <tr>
                <th>
                    @Html.DisplayNameFor(model => model.Title)
                </th>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <th></th>
                }
            </tr>
        </thead>
        <tbody>
    @foreach (var item in Model) 
    {
            <tr>
                <td>
                    @Html.DisplayFor(model => item.Title)
                </td>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <td>
                    @if (User.IsInRole("Admin") || User.IsInRole("Modo"))
                    {
                        <a asp-action="Edit" asp-route-id="@item.Id">Edit</a>
                        <a asp-action="Details" asp-route-id="@item.Id">Details</a>
                    }

                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                    }
                </td>
            }
            </tr>
    }
        </tbody>
    </table>
}


